{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dekkmarsvin/tw_doujin_event-reference-data/schemas/v1/reference-pin.schema.json",
  "title": "Reference data pin v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "eventId", "repository", "commit", "files", "selection"],
  "properties": {
    "schema": { "const": "reference-data-pin/1" },
    "eventId": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "repository": { "const": "dekkmarsvin/tw_doujin_event-reference-data" },
    "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.json$" },
          "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    },
    "selection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["organizer", "categoryCatalog", "venue", "venueSpaces"],
      "properties": {
        "organizer": { "$ref": "#/$defs/idPath" },
        "categoryCatalog": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "organizerId", "revision", "path"],
          "properties": {
            "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "organizerId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
            "revision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
            "path": { "type": "string", "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.json$" }
          }
        },
        "venue": { "$ref": "#/$defs/idPath" },
        "venueSpaces": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/idPath" } }
      }
    }
  },
  "$defs": {
    "idPath": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
        "path": { "type": "string", "pattern": "^data/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*\\.json$" }
      }
    }
  }
}
