{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dekkmarsvin/tw_doujin_event-reference-data/schemas/v1/category-catalog.schema.json",
  "title": "Organizer category catalog v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "organizerId", "revision", "categories", "sources", "provenance"],
  "properties": {
    "schema": { "const": "category-catalog/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "organizerId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "revision": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
    "categories": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "allOf": [
          { "$ref": "source.schema.json" },
          { "properties": { "kind": { "const": "organizer-official" } } }
        ]
      }
    },
    "provenance": { "$ref": "organizer.schema.json#/$defs/provenance" }
  }
}
