{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dekkmarsvin/tw_doujin_event-reference-data/schemas/v1/venue-space.schema.json",
  "title": "VenueSpaceRecord v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "venueId", "name", "sources", "provenance"],
  "properties": {
    "schema": { "const": "venue-space/1" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "venueId": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "source.schema.json" } },
    "provenance": { "$ref": "organizer.schema.json#/$defs/provenance" }
  }
}
